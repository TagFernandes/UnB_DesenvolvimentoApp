# Template das variáveis de ambiente. Este arquivo VAI para o git (sem valores).
#
# Como usar:
#   1. Copie para .env.local:  cp .env.example .env.local
#   2. Preencha com o firebaseConfig do app Web:
#      Console do Firebase > Configurações do projeto > Seus apps > App da Web
#   3. Reinicie o servidor:  npx expo start --clear
#
# O .env.local é ignorado pelo git (.env*.local no .gitignore).
# Variáveis EXPO_PUBLIC_ são embutidas no app e ficam visíveis para quem o usa;
# a segurança do Firebase vem das regras e dos métodos de login ativados no console.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
