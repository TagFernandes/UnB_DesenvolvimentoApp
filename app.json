{
  "expo": {
    "name": "desenvolvimento-de-aplicativos",
    "slug": "desenvolvimento-de-aplicativos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "mapeei",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O mapeei precisa acessar suas fotos para você escolher a foto de perfil.",
          "cameraPermission": "O mapeei precisa acessar a câmera para você tirar a foto de perfil."
        }
      ]
    ]
  }
}
